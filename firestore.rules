rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // RK FASHIONS POS - Store data rules
    // Allows your POS terminals to read and sync products, inventory, and sales
    match /stores/{storeId} {
      allow read, write: if true;
      match /{allChildren=**} {
        allow read, write: if true;
      }
    }
  }
}
