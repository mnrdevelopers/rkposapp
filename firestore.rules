rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check that the request comes from an authenticated Firebase session
    function isSignedIn() {
      return request.auth != null;
    }

    // Stores & all subcollections (products, variants, sales, items, settings)
    match /stores/{storeId} {
      allow read, write: if isSignedIn();
      match /{allChildren=**} {
        allow read, write: if isSignedIn();
      }
    }

    // Store Code lookup — any authenticated terminal can read; only auth'd users write
    match /storeCodes/{code} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // User profiles — any signed-in user can read their own doc; write only to own doc
    match /users/{userId} {
      allow read:  if isSignedIn() && request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
